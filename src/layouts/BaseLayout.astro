---
import '../styles/global.css';
import SiteNav from '@components/nav/SiteNav.astro';

interface Props {
  title: string;
  description?: string;
  transparentNav?: boolean;
}

const {
  title,
  description = 'Porlin — Architectural Portfolio',
  transparentNav = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — Porlin</title>
  </head>
  <body class="min-h-screen bg-canvas text-ink antialiased">
    <SiteNav transparent={transparentNav} />
    <main class="page-fade">
      <slot />
    </main>
    <footer class="border-t border-concrete/20 px-8 py-6 mt-24">
      <p class="font-sans text-xs text-concrete tracking-widest text-center uppercase">
        © {new Date().getFullYear()} Porlin. All rights reserved.
      </p>
    </footer>
  </body>
</html>
