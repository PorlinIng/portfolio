---
// Placeholder bio — real content added in Phase 4
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<div class="max-w-3xl mx-auto px-8 pt-32 pb-24">
  <h1 class="font-serif font-light text-6xl text-ink mb-12">About</h1>

  <div class="grid md:grid-cols-2 gap-16 items-start">
    <!-- Portrait -->
    <div class="aspect-[3/4] overflow-hidden">
      <img
        src={`${base}images/porlin_ing_profile_image.png`}
        alt="Porlin Ing"
        class="w-full h-full object-cover object-top"
      />
    </div>

    <!-- Bio text -->
    <div class="space-y-6 font-serif text-lg leading-relaxed text-ink/90 pt-4">
      <p>
        Porlin is an architect and designer with a practice spanning residential, hospitality,
        and civic scales. The work is rooted in a belief that architecture should speak the
        language of its place while aspiring toward timeless clarity.
      </p>
      <p>
        Trained at the Royal University of Fine Arts in Phnom Penh, and with professional
        experience at ASMA Architects, Porlin brings a considered approach to form, material,
        and spatial storytelling — from large-scale hospitality architecture to facade
        composition and interior environments.
      </p>
    </div>
  </div>
</div>
