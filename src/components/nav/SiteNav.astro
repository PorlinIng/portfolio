---
interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const navLinks = [
  { href: `${base}projects`, label: 'Projects' },
  { href: `${base}sketches`, label: 'Sketches' },
  { href: `${base}about`, label: 'About' },
  { href: `${base}contact`, label: 'Contact' },
];
const currentPath = Astro.url.pathname;
---

<nav class:list={[
  'fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-8 py-6 transition-colors duration-300',
  transparent ? 'bg-transparent' : 'bg-canvas border-b border-concrete/20',
]}>
  <a href={base} class:list={[
    'font-serif text-xl tracking-widest uppercase',
    transparent ? 'text-canvas' : 'text-ink',
  ]}>
    Porlin
  </a>

  <!-- Desktop links -->
  <ul class="hidden md:flex items-center gap-8">
    {navLinks.map(({ href, label }) => (
      <li>
        <a
          href={href}
          class:list={[
            'font-sans text-xs uppercase tracking-widest transition-colors duration-200',
            transparent ? 'text-canvas/80 hover:text-canvas' : 'text-concrete hover:text-ink',
            currentPath.startsWith(href) ? (transparent ? 'text-canvas' : 'text-ink') : '',
          ]}
        >
          {label}
        </a>
      </li>
    ))}
  </ul>

  <!-- Hamburger button (mobile only) -->
  <button
    id="nav-toggle"
    class:list={[
      'md:hidden flex flex-col justify-center gap-1.5 w-8 h-8 z-[60] relative border-none bg-transparent outline-none cursor-pointer',
      transparent ? 'text-canvas' : 'text-ink',
    ]}
    aria-label="Toggle menu"
  >
    <span class="hamburger-line block h-px w-full bg-current transition-all duration-300 origin-center"></span>
    <span class="hamburger-line block h-px w-full bg-current transition-all duration-300 origin-center"></span>
    <span class="hamburger-line block h-px w-full bg-current transition-all duration-300 origin-center"></span>
  </button>
</nav>

<!-- Full-screen overlay -->
<div
  id="nav-overlay"
  class="fixed inset-0 z-40 bg-black/65 flex flex-col items-center justify-center gap-8
         opacity-0 pointer-events-none transition-opacity duration-300"
>
  {navLinks.map(({ href, label }) => (
    <a
      href={href}
      class:list={[
        'font-sans text-sm uppercase tracking-widest text-canvas/80 hover:text-canvas transition-colors duration-200',
        currentPath.startsWith(href) ? 'text-canvas' : '',
      ]}
    >
      {label}
    </a>
  ))}
</div>

<script>
  const toggle = document.getElementById('nav-toggle');
  const overlay = document.getElementById('nav-overlay');
  const lines = toggle?.querySelectorAll('.hamburger-line');

  let open = false;

  toggle?.addEventListener('click', () => {
    open = !open;

    if (open) {
      overlay?.classList.remove('opacity-0', 'pointer-events-none');
      overlay?.classList.add('opacity-100');
      // Animate to X
      lines?.[0].style.setProperty('transform', 'translateY(8px) rotate(45deg)');
      lines?.[1].style.setProperty('opacity', '0');
      lines?.[2].style.setProperty('transform', 'translateY(-8px) rotate(-45deg)');
    } else {
      overlay?.classList.add('opacity-0', 'pointer-events-none');
      overlay?.classList.remove('opacity-100');
      // Reset to hamburger
      lines?.[0].style.removeProperty('transform');
      lines?.[1].style.removeProperty('opacity');
      lines?.[2].style.removeProperty('transform');
    }
  });

  // Close on link click
  overlay?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      open = false;
      overlay.classList.add('opacity-0', 'pointer-events-none');
      overlay.classList.remove('opacity-100');
      lines?.[0].style.removeProperty('transform');
      lines?.[1].style.removeProperty('opacity');
      lines?.[2].style.removeProperty('transform');
    });
  });
</script>
