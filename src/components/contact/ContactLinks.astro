---

<div class="max-w-2xl mx-auto px-8 pt-32 pb-24">
  <h1 class="font-serif font-light text-6xl text-ink mb-4">Contact</h1>
  <p class="font-serif italic text-concrete text-xl mb-16">Let's build something meaningful.</p>

  <ul class="space-y-6">
    {channels.map(({ label, value, href, icon, secondValue, secondHref }) => (
      <li class="flex items-start gap-4">
        <span class="text-concrete mt-1 shrink-0" set:html={icon} />
        <span>
          <span class="block font-sans text-xs uppercase tracking-widest text-concrete mb-0.5">
            {label}
          </span>
          <a href={href} class="block font-serif text-xl text-ink hover:text-timber transition-colors duration-200">
            {value}
          </a>
          {secondValue && secondHref && (
            <a href={secondHref} class="block font-serif text-xl text-ink hover:text-timber transition-colors duration-200">
              {secondValue}
            </a>
          )}
        </span>
      </li>
    ))}
  </ul>
</div>
