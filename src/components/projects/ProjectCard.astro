---
import CoverImage from '@components/ui/CoverImage.astro';

interface Props {
  slug: string;
  title: string;
  category: string;
  year: number;
  coverImage: string;
  coverAlt: string;
}

const { slug, title, category, year, coverImage, coverAlt } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<a href={`${base}projects/${slug}`} class="project-card group block">
  <CoverImage src={coverImage} alt={coverAlt} imgClass="transition-transform duration-700 group-hover:scale-105">
    <!-- Hover overlay -->
    <div class="project-card-overlay absolute inset-0 bg-ink/60 flex flex-col justify-end p-6">
      <span class="font-sans text-xs uppercase tracking-widest text-timber mb-2">
        {category} · {year}
      </span>
      <h3 class="font-serif text-2xl text-canvas leading-tight">
        {title}
      </h3>
    </div>
  </CoverImage>
</a>
