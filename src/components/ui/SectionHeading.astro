---
/**
 * SectionHeading — canonical section header for all pages.
 *
 * ALWAYS use this component for <h2> section labels.
 * NEVER hardcode heading typography inline — that's how inconsistency creeps in.
 *
 * Usage:
 *   import SectionHeading from '@components/ui/SectionHeading.astro';
 *   <SectionHeading>Building Exterior</SectionHeading>
 */
---

<h2 class="font-serif text-2xl text-ink mb-8">
  <slot />
</h2>
