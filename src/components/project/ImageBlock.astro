---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  wide?: boolean;
}

const { src, alt, caption, wide = false } = Astro.props;
---

<figure class:list={['my-12', wide ? 'w-full' : 'max-w-4xl mx-auto px-8']}>
  <img
    src={src}
    alt={alt}
    class="w-full object-cover"
    loading="lazy"
    data-parallax
  />
  {caption && (
    <figcaption class="mt-3 font-sans text-xs text-concrete tracking-wide">
      {caption}
    </figcaption>
  )}
</figure>
