---
interface Props {
  category: string;
  year: number;
  role: string;
  firm?: string;
}

const { category, year, role, firm } = Astro.props;

const items = [
  { label: 'Type',  value: category },
  { label: 'Year',  value: String(year) },
  { label: 'Role',  value: role },
  ...(firm ? [{ label: 'Firm', value: firm }] : []),
];
---

<div class="border-t border-concrete/30 mt-24 pt-12 px-8 max-w-4xl mx-auto">
  <dl class="grid grid-cols-2 md:grid-cols-4 gap-8">
    {items.map(({ label, value }) => (
      <div>
        <dt class="font-sans text-xs uppercase tracking-widest text-concrete mb-1">{label}</dt>
        <dd class="font-serif text-lg text-ink">{value}</dd>
      </div>
    ))}
  </dl>
</div>
