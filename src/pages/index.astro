---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroImage from '@components/home/HeroImage.astro';
import { getCollection } from 'astro:content';
import ProjectGrid from '@components/projects/ProjectGrid.astro';

const allProjects = await getCollection('projects');
const featured = allProjects.filter((p) => p.data.featured);
---

<BaseLayout title="Home" transparentNav={true}>
  <!-- Full-screen hero (no top padding — nav overlays it) -->
  <div class="-mt-0">
    <HeroImage />
  </div>

  <!-- Featured projects teaser -->
  {featured.length > 0 && (
    <section class="px-8 pt-24 pb-16">
      <h2 class="font-sans text-xs uppercase tracking-widest text-concrete mb-8">
        Selected Work
      </h2>
      <ProjectGrid projects={featured} />
      <div class="mt-8 text-center">
        <a href="/projects" class="font-sans text-xs uppercase tracking-widest text-concrete hover:text-ink transition-colors duration-200 border-b border-concrete/40 pb-0.5">
          View All Projects
        </a>
      </div>
    </section>
  )}
</BaseLayout>
