---
import BaseLayout from '@layouts/BaseLayout.astro';
import SketchGrid from '@components/sketches/SketchGrid.astro';
---

<BaseLayout title="Sketches">
  <!-- Sketches page uses a slightly more cream background, overridden locally -->
  <div class="min-h-screen bg-[#EDE9E0]">
    <div class="px-8 pt-32 pb-8">
      <h1 class="font-serif font-light text-6xl text-ink mb-2">Sketches</h1>
      <p class="font-sans text-xs uppercase tracking-widest text-concrete mb-12">
        Hand drawings &amp; AI interpretations
      </p>
    </div>
    <SketchGrid />
  </div>
</BaseLayout>
